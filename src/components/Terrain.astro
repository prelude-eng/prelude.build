---
// A deterministic point field, projected into an abstract landscape.
// Geometry is rendered at build time; motion needs no drawing loop or library.
const rows = Array.from({ length: 34 }, (_, row) => {
  const depth = row / 33;
  return Array.from({ length: 77 }, (_, column) => {
    const across = column / 76 * 2 - 1;
    const peak = 194 * Math.exp(-((across - .2) ** 2 / .115 + (depth - .51) ** 2 / .095));
    const shoulder = 91 * Math.exp(-((across + .48) ** 2 / .17 + (depth - .66) ** 2 / .065));
    const ripple = Math.sin(across * 9 + depth * 9) * Math.cos(depth * 6) * 10;
    const x = 400 + across * (240 + depth * 150) + (depth - .5) * 90;
    const y = 151 + depth * 260 - peak - shoulder + ripple;
    const edge = Math.min(1, Math.max(0, (x - 50) / 150), Math.max(0, (810 - x) / 90));
    return { x: x.toFixed(2), y: y.toFixed(2), radius: (.65 + depth * .8).toFixed(2), opacity: ((.25 + depth * .55) * edge).toFixed(2) };
  });
});
---
<div class="terrain">
  <svg class="terrain-art" viewBox="0 0 800 470" fill="none" aria-hidden="true" focusable="false">
    <g class="terrain-registration" stroke="currentColor" stroke-width="1">
      <path d="M149 95h12m-6-6v12M665 118h12m-6-6v12M714 337h12m-6-6v12" />
      <path d="M96 300v12h12M702 72h12v12" />
    </g>
    <g fill="currentColor">
      {rows.map(points => <g class="terrain-row">{points.map(point => <circle cx={point.x} cy={point.y} r={point.radius} opacity={point.opacity} />)}</g>)}
    </g>
  </svg>
</div>

<style>
  .terrain { position: relative; width: 100%; color: var(--color-cyan); }
  .terrain-art { display: block; width: 100%; height: auto; overflow: visible; }
  .terrain-registration { color: var(--color-slate); opacity: .35; }
  .terrain-row { animation: terrain-ripple 7s ease-in-out infinite; }
  .terrain-row:nth-child(6n + 1) { animation-delay: -1.1s; }
  .terrain-row:nth-child(6n + 2) { animation-delay: -2.2s; }
  .terrain-row:nth-child(6n + 3) { animation-delay: -3.3s; }
  .terrain-row:nth-child(6n + 4) { animation-delay: -4.4s; }
  .terrain-row:nth-child(6n + 5) { animation-delay: -5.5s; }
  @keyframes terrain-ripple { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @media (prefers-reduced-motion: reduce) { .terrain-row { animation: none; } }
</style>
